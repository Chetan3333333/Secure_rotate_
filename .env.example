# MySQL (required — application will exit if MySQL is unreachable)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=securerotate

# Flask
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=0

# Admin seed (first run only — change immediately after first login)
ADMIN_EMAIL=admin@securedb.com
ADMIN_PASSWORD=

# Optional SMTP (OTP emails). Leave empty for local demo.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

TOKEN_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
